# Heroku Inference - LLM API (OpenAI-compatible)
HEROKU_INFERENCE_URL=https://us.inference.heroku.com/v1
HEROKU_INFERENCE_KEY=your_heroku_inference_key_here
HEROKU_MODEL=claude-sonnet-4-6

# Redis - Conversation session storage
REDIS_URL=redis://localhost:6379

# SQLite database file for all bot/agent state (sessions, plan, athlete,
# journal, gcal sync). Defaults to state/coach.db locally. On Railway, set
# this to /app/data/coach.db and mount a persistent volume at /app/data so
# writes survive deploys and restarts. See README "Deploy" for the setup.
DATABASE_PATH=state/coach.db

# Telegram Bot (get token from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Webhook URL (your deployed app URL, e.g. https://your-app.railway.app)
WEBHOOK_URL=https://your-app-url.railway.app

# Optional: Telegram webhook secret for request verification
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Optional: Override race date (ISO format, e.g. 2026-04-20)
RACE_DATE=

# Optional: User timezone (IANA format, e.g. America/New_York, America/Los_Angeles)
# If unset, uses server's local time. Important if runner and server are in different timezones.
USER_TIMEZONE=

# --- Strava integration ---
# Create an API app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Shared secret used to verify webhook subscription registration.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
STRAVA_VERIFY_TOKEN=

# Telegram chat ID for the Strava auto-log ping.
# Find with: visit https://api.telegram.org/bot<TOKEN>/getUpdates after sending
# the bot a message; look for chat.id in the response.
USER_TELEGRAM_CHAT_ID=

# Where to persist Strava OAuth tokens.
#   "file"  (default) — .strava_tokens.json in the repo root. Best locally.
#   "redis"           — store in the Redis already used for chat history.
#                       Use this on Railway since the filesystem is ephemeral.
STRAVA_TOKENS_BACKEND=file

# --- Google Calendar integration ---
# Push the weekly plan.md table into a dedicated "PRE Training" calendar.
# One-time setup: GCP Console → enable Google Calendar API → OAuth consent
# (External, add yourself as Test User) → create OAuth client → application
# type **Desktop app** → copy client_id / client_secret here.
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=

# Calendar ID of the dedicated "PRE Training" calendar you create manually
# in the Google Calendar UI (Settings → "Integrate calendar" → Calendar ID).
# The bot only ever writes to this calendar — never your primary.
CALENDAR_ID=

# Where to persist Google Calendar OAuth tokens. Same shape as
# STRAVA_TOKENS_BACKEND — "file" for local dev, "redis" for Railway.
GCAL_TOKENS_BACKEND=file
